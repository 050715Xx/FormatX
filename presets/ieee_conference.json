{
  "name": "IEEE Conference",
  "page_setup": {
    "paper_size": "Letter",
    "margin": {
      "top_cm": 1.905,
      "bottom_cm": 2.54,
      "left_cm": 1.57,
      "right_cm": 1.57
    },
    "columns": {
      "count": 2,
      "space_cm": 0.64,
      "equal_width": true,
      "separator": false
    }
  },
  "styles": {
    "normal": {
      "font_cn": "Times New Roman",
      "font_en": "Times New Roman",
      "size_pt": 10.0,
      "bold": false,
      "italic": false,
      "alignment": "justify",
      "first_line_indent_cm": 0.50,
      "left_indent_cm": 0.0,
      "hanging_indent_cm": 0.0,
      "line_spacing_pt": 11.4,
      "space_before_pt": 0.0,
      "space_after_pt": 6.0
    },
    "heading1": {
      "font_cn": "Times New Roman",
      "font_en": "Times New Roman",
      "size_pt": 10.0,
      "bold": false,
      "italic": false,
      "alignment": "center",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "line_spacing_pt": 11.4,
      "space_before_pt": 8.0,
      "space_after_pt": 4.0
    },
    "heading2": {
      "font_cn": "Times New Roman",
      "font_en": "Times New Roman",
      "size_pt": 10.0,
      "bold": false,
      "italic": true,
      "alignment": "left",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "line_spacing_pt": 11.4,
      "space_before_pt": 6.0,
      "space_after_pt": 3.0
    },
    "heading3": {
      "font_cn": "Times New Roman",
      "font_en": "Times New Roman",
      "size_pt": 10.0,
      "bold": false,
      "italic": true,
      "alignment": "justify",
      "first_line_indent_cm": 0.50,
      "left_indent_cm": 0.0,
      "line_spacing_pt": 12.0,
      "space_before_pt": 0.0,
      "space_after_pt": 0.0
    },
    "code_block": {
      "font_en": "Consolas",
      "size_pt": 9.0,
      "first_line_indent_cm": 0.0,
      "line_spacing_pt": 12.0,
      "alignment": "left"
    },
    "references_body": {
      "font_cn": "Times New Roman",
      "font_en": "Times New Roman",
      "size_pt": 8.0,
      "bold": false,
      "italic": false,
      "alignment": "justify",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "hanging_indent_cm": 0.0,
      "line_spacing_pt": 9.0,
      "space_before_pt": 0.0,
      "space_after_pt": 2.5
    },
    "caption": {
      "font_cn": "Times New Roman",
      "font_en": "Times New Roman",
      "size_pt": 8.0,
      "bold": false,
      "italic": false,
      "alignment": "justify",
      "first_line_indent_cm": 0.0,
      "left_indent_cm": 0.0,
      "line_spacing_pt": 10.0,
      "space_before_pt": 4.0,
      "space_after_pt": 10.0
    }
  },
  "heading_detection": {
    "front_matter_titles": ["Abstract", "Keywords", "References", "Acknowledgment", "Acknowledgement", "Appendix", "Appendices"],
    "numbered_heading_patterns": [
      {"pattern": "^[IVXLCDM]+\\.\\s",  "level": 1},
      {"pattern": "^[A-Z]\\.\\s",       "level": 2},
      {"pattern": "^\\d+\\)\\s",        "level": 3},
      {"pattern": "^\\d+\\.[\\t ]",     "level": 2}
    ]
  }
}
